pipeline {
    agent any
    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    environment {
        IMAGEN = "inventario:${BUILD_NUMBER}"
    }
    stages {
        stage('Pruebas unitarias') {
            steps {
                sh 'sh app/ci/pruebas.sh'
            }
            post {
                always {
                    junit 'app/reportes/junit.xml'
                }
            }
        }
