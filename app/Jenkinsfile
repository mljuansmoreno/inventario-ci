pipeline {
    agent any
    triggers {
        pollSCM('H/2 * * * *')
    }
    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
    }
    environment {
        IMAGEN = "inventario:${BUILD_NUMBER}"
    }
    stages {
        stage('Pruebas unitarias') {
            steps {
                sh 'sh app/ci/pruebas.sh'
            }
            post {
                always {
                    junit 'app/reportes/junit.xml'
                }
            }
        }
        stage('Construir imagen') {
            steps {
                sh 'docker build -t "$IMAGEN" app'
            }
        }
        stage('Prueba de humo') {
            steps {
                sh 'sh app/ci/humo.sh "$IMAGEN"'
            }
        }
    }
}
